{
  "description": "每個 session 開始時載入溝通規則",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat",
            "args": ["${CLAUDE_PLUGIN_ROOT}/rules/communication.md"]
          }
        ]
      }
    ]
  }
}
